# StepDaddy Gateway — local dev / CI only (never commit real secrets)

# GitHub CLI token for releases (export in shell, do not save here)
# GH_TOKEN=
# GITHUB_TOKEN=

# Android SDK (local machine)
# ANDROID_HOME=~/Android/Sdk

# Optional: release signing (see docs/RELEASE.md) — paths only, no passwords in repo
# KEYSTORE_FILE=/secure/path/stepdaddy-release.jks
