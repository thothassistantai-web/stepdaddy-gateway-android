<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/label_playlist_card"
            android:src="@drawable/ic_link" />

        <TextView
            style="@style/Widget.StepDaddyGateway.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_playlist_card" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/label_playlist_fast"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textPlaylistUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/url_accent"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textTiviMatePlaylistState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCopyPlaylist"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/switchTivimateWatch"
            android:nextFocusRight="@id/buttonOpenPlaylist"
            android:nextFocusUp="@id/switchAutoStart"
            android:nextFocusDown="@id/buttonCopySmartPlaylist"
            android:text="@string/action_copy"
            app:icon="@drawable/ic_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenPlaylist"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/buttonCopyPlaylist"
            android:nextFocusRight="@id/buttonQrPlaylist"
            android:nextFocusUp="@id/switchLaunchTivimate"
            android:nextFocusDown="@id/buttonCopySmartPlaylist"
            android:text="@string/action_open"
            app:icon="@drawable/ic_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonQrPlaylist"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/buttonOpenPlaylist"
            android:nextFocusRight="@id/buttonCopyEpg"
            android:nextFocusUp="@id/switchBoot"
            android:nextFocusDown="@id/buttonCopySmartPlaylist"
            android:text="@string/action_qr_code"
            app:icon="@drawable/ic_qr" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_playlist_smart"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textSmartPlaylistUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/url_accent"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCopySmartPlaylist"
        style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:nextFocusLeft="@id/buttonCopyPlaylist"
        android:nextFocusRight="@id/buttonLaunchTivimate"
        android:nextFocusUp="@id/buttonCopyPlaylist"
        android:nextFocusDown="@id/buttonLaunchTivimate"
        android:text="@string/action_copy_smart"
        app:icon="@drawable/ic_copy" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLaunchTivimate"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/buttonCopySmartPlaylist"
            android:nextFocusRight="@id/buttonInstallTivimate"
            android:nextFocusUp="@id/buttonCopySmartPlaylist"
            android:nextFocusDown="@id/buttonCopyEpg"
            android:text="@string/action_launch_tivimate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonInstallTivimate"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/buttonLaunchTivimate"
            android:nextFocusRight="@id/buttonCopyEpg"
            android:nextFocusUp="@id/buttonCopySmartPlaylist"
            android:nextFocusDown="@id/buttonOpenEpg"
            android:text="@string/action_install_tivimate" />
    </LinearLayout>
</LinearLayout>
