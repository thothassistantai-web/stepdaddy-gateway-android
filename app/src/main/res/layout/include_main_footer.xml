<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewFooterStatusDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_stat_indicator_offline" />

    <TextView
        android:id="@+id/textFooterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/footer_status_offline"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterUptime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:text="@string/footer_uptime_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterClients"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/footer_clients_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterMemory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/footer_memory_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterUpdate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/footer_update"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/buttonFooterScrollTop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_footer_scroll_button"
        android:contentDescription="@string/action_scroll_top"
        android:focusable="true"
        android:foreground="@drawable/tv_icon_button_focused"
        android:nextFocusLeft="@id/buttonOpenEpg"
        android:nextFocusUp="@id/buttonOpenEpg"
        android:nextFocusRight="@id/buttonHeaderSettings"
        android:padding="6dp"
        android:src="@drawable/ic_scroll_top" />
</LinearLayout>
