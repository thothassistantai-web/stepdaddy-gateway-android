<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewFooterStatusDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_stat_indicator_offline" />

    <TextView
        android:id="@+id/textFooterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/footer_status_offline"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterUptime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="@string/footer_uptime_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterClients"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/footer_clients_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterMemory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/footer_memory_placeholder"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textFooterUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/footer_update"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
