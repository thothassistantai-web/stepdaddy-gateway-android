<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/install_apps_title"
        android:textColor="@color/on_background"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_background_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/toolbarActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRefresh"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusRight="@id/buttonSelectAll"
            android:text="@string/install_apps_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSelectAll"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:nextFocusLeft="@id/buttonRefresh"
            android:nextFocusRight="@id/buttonBatchInstall"
            android:text="@string/install_apps_select_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBatchInstall"
            style="@style/Widget.StepDaddyGateway.TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:nextFocusLeft="@id/buttonSelectAll"
            android:nextFocusRight="@id/buttonBack"
            android:text="@string/install_apps_batch_install" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:nextFocusLeft="@id/buttonBatchInstall"
            android:text="@string/action_back" />
    </LinearLayout>

    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/install_apps_empty"
        android:textColor="@color/on_background_muted"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:paddingBottom="16dp" />

</LinearLayout>
