<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/fullscreenInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textFullscreenChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_background"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFullscreenGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_background"
            android:alpha="0.85"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fullscreenControlOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFullscreenChDown"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:foreground="@drawable/tv_icon_button_focused"
            android:text="@string/bottom_panel_ch_down"
            app:icon="@drawable/ic_channel_down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFullscreenPlayPause"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:foreground="@drawable/tv_icon_button_focused"
            android:text="@string/bottom_panel_play_pause"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFullscreenChUp"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:foreground="@drawable/tv_icon_button_focused"
            android:text="@string/bottom_panel_ch_up"
            app:icon="@drawable/ic_channel_up" />
    </LinearLayout>

    <include layout="@layout/include_player_error_overlay" />
</FrameLayout>
