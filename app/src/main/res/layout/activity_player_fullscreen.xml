<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <TextView
        android:id="@+id/textFullscreenChannel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/on_background"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/buttonFullscreenBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_footer_scroll_button"
        android:contentDescription="@string/action_back"
        android:focusable="true"
        android:foreground="@drawable/tv_icon_button_focused"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right" />
</FrameLayout>
