<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/card_server_controls"
            android:src="@drawable/ic_server_controls" />

        <TextView
            style="@style/Widget.StepDaddyGateway.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/card_server_controls" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToggleServer"
            style="@style/Widget.StepDaddyGateway.TvButton.Start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:nextFocusLeft="@id/buttonHeaderSettings"
            android:nextFocusRight="@id/buttonRestart"
            android:nextFocusUp="@id/statCardChannels"
            android:nextFocusDown="@id/buttonSettings"
            android:text="@string/action_start_server"
            app:icon="@drawable/ic_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRestart"
            style="@style/Widget.StepDaddyGateway.TvButton.Restart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:nextFocusLeft="@id/buttonToggleServer"
            android:nextFocusRight="@id/buttonSettings"
            android:nextFocusUp="@id/statCardPrograms"
            android:nextFocusDown="@id/buttonSettings"
            android:text="@string/action_restart_short"
            app:icon="@drawable/ic_restart" />
    </LinearLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_stopped"
        android:textColor="@color/on_background"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textNetworkMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textPeerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/url_accent"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
