<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/on_background"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/panelStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_background_muted"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/panelStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="false"
            app:cardBackgroundColor="@color/panel_background"
            app:cardCornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guidelineSplit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="280dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_dashboard"
                    android:textColor="@color/on_background"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textHealthStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/status_stopped"
                    android:textColor="@color/status_neutral"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/on_background_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textProviders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/on_background_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textErrors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/status_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="8"
                    android:textColor="@color/on_background_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineSplit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.58" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_stopped"
            android:textColor="@color/on_background"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textVersion" />

        <TextView
            android:id="@+id/textPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textStatus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStart"
            style="@style/Widget.StepDaddyGateway.TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nextFocusDown="@id/buttonSettings"
            android:nextFocusRight="@id/buttonStop"
            android:text="@string/action_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textPort" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStop"
            style="@style/Widget.StepDaddyGateway.TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:enabled="false"
            android:nextFocusDown="@id/buttonInstallApps"
            android:text="@string/action_stop"
            app:layout_constraintBaseline_toBaselineOf="@id/buttonStart"
            app:layout_constraintStart_toEndOf="@id/buttonStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSettings"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nextFocusRight="@id/buttonInstallApps"
            android:nextFocusUp="@id/buttonStart"
            android:text="@string/action_settings"
            app:icon="@drawable/ic_notification"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonInstallApps"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:nextFocusUp="@id/buttonStop"
            android:text="@string/action_install_apps"
            app:icon="@drawable/ic_install_apps"
            app:layout_constraintBaseline_toBaselineOf="@id/buttonSettings"
            app:layout_constraintStart_toEndOf="@id/buttonSettings" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:text="@string/label_auto_start_on_launch"
            android:textColor="@color/on_background"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonSettings" />

        <TextView
            android:id="@+id/textAutoStartHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/label_auto_start_on_launch_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchAutoStart" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLaunchTivimate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:text="@string/label_launch_tivimate"
            android:textColor="@color/on_background"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textAutoStartHint" />

        <TextView
            android:id="@+id/textLaunchTivimateHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/label_launch_tivimate_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchLaunchTivimate" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBoot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:text="@string/label_start_on_boot"
            android:textColor="@color/on_background"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textLaunchTivimateHint" />

        <TextView
            android:id="@+id/textBootHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/label_start_on_boot_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchBoot" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchTivimateWatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:text="@string/label_tivimate_watch"
            android:textColor="@color/on_background"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textBootHint" />

        <TextView
            android:id="@+id/textTivimateWatchHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/label_tivimate_watch_hint"
            android:textColor="@color/on_background_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchTivimateWatch" />

        <TextView
            android:id="@+id/labelTivimateSetup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_tivimate_setup"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTivimateWatchHint" />

        <TextView
            android:id="@+id/textTivimateHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hint_tivimate_setup"
            android:textColor="@color/on_background_muted"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelTivimateSetup" />

        <TextView
            android:id="@+id/labelPlaylist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_playlist"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTivimateHint" />

        <TextView
            android:id="@+id/textPlaylistUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_background_muted"
            android:textIsSelectable="true"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelPlaylist" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCopyPlaylist"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_copy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textPlaylistUrl" />

        <TextView
            android:id="@+id/labelEpg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_epg"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonCopyPlaylist" />

        <TextView
            android:id="@+id/textEpgUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_background_muted"
            android:textIsSelectable="true"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelEpg" />

        <TextView
            android:id="@+id/textEpgStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_background_muted"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guidelineSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textEpgUrl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCopyEpg"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/action_copy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textEpgStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
