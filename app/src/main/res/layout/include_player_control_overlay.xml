<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerControlOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp"
    android:visibility="gone">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOverlayChDown"
        style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:text="@string/bottom_panel_ch_down"
        app:icon="@drawable/ic_channel_down" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOverlayChPlay"
        style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:text="@string/bottom_panel_play_pause"
        app:icon="@drawable/ic_play" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOverlayChUp"
        style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:text="@string/bottom_panel_ch_up"
        app:icon="@drawable/ic_channel_up" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOverlayFullscreen"
        style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:text="@string/bottom_panel_fullscreen"
        app:icon="@drawable/ic_fullscreen" />
</LinearLayout>
