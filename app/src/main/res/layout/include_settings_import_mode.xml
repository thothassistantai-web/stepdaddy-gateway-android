<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_import_mode_label"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleImportMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:checkedButton="@id/buttonImportFull"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonImportFull"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_import_mode_full"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonImportSkip"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_import_mode_skip"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonImportFallback"
            style="@style/Widget.StepDaddyGateway.TvButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_import_mode_fallback"
            android:textSize="11sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
