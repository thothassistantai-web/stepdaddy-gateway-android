<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_gateway_health"
        style="@style/Widget.StepDaddyGateway.CardTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageHealthBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/label_gateway_health"
            android:src="@drawable/ic_status_check" />

        <TextView
            android:id="@+id/textHealthStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:minWidth="120dp"
            android:text="@string/status_offline_upper"
            android:textColor="@color/status_neutral"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textHealthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/dashboard_health_offline_detail"
            android:textColor="@color/on_background_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_background_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textErrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_error"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/panel_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_provider_statistics"
        style="@style/Widget.StepDaddyGateway.CardTitle" />

    <LinearLayout
        android:id="@+id/containerProviderBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/textProvidersTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_background_muted"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/panel_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_category_breakdown"
        style="@style/Widget.StepDaddyGateway.CardTitle" />

    <LinearLayout
        android:id="@+id/containerCategoryBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />
</LinearLayout>
