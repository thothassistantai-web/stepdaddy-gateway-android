<resources>
    <style name="Theme.StepDaddyGateway" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="strokeColor">@color/panel_border</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton.Start" parent="Widget.StepDaddyGateway.TvButton">
        <item name="backgroundTint">@color/btn_start</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton.Restart" parent="Widget.StepDaddyGateway.TvButton">
        <item name="backgroundTint">@color/btn_restart</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton.Stop" parent="Widget.StepDaddyGateway.TvButton">
        <item name="backgroundTint">@color/btn_stop</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Widget.StepDaddyGateway.TvButton.Management" parent="Widget.StepDaddyGateway.TvButton">
        <item name="backgroundTint">@color/btn_management</item>
        <item name="strokeColor">@color/panel_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="iconTint">@color/on_background</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.StepDaddyGateway.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="Widget.StepDaddyGateway.CardTitle" parent="">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
